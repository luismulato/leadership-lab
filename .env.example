# Copy to .env (make setup does it). .env is git-ignored: never commit it.
# Admin keys protect /app-admin/ and /<app>/admin/. Use a strong one (12+ chars) for anything that is online.

# Local environments (defaults shown; you may leave them out)
ADMIN_KEY_DEV=dev-admin-key
ADMIN_KEY_TEST=test-admin-key

# Production (required by `make deploy ENV=prod`)
ADMIN_KEY_PROD=
